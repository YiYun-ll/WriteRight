{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradingReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "part",
    "grading_mode",
    "score",
    "word_count",
    "rubric_version",
    "prompt_version",
    "model_id",
    "overall_comment",
    "dimensions",
    "task_checks",
    "corrections",
    "rewrites",
    "review"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "part": {
      "enum": [
        "A",
        "B"
      ]
    },
    "grading_mode": {
      "enum": [
        "full",
        "language_only"
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "max",
        "band",
        "range",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max": {
          "enum": [
            10,
            15
          ]
        },
        "band": {
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "rubric_version": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "overall_comment": {
      "type": "string"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "level",
          "explanation",
          "evidence_sentence_ids"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "evidence_sentence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "task_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "point_id",
          "status",
          "reason",
          "evidence_sentence_ids"
        ],
        "properties": {
          "point_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "partial",
              "failed",
              "uncertain"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence_sentence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sentence_id",
          "original",
          "minimal_corrected",
          "category",
          "severity",
          "impact",
          "reason_zh",
          "optional_upgrade"
        ],
        "properties": {
          "sentence_id": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "minimal_corrected": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "impact": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reason_zh": {
            "type": "string"
          },
          "optional_upgrade": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "rewrites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimal",
        "enhanced"
      ],
      "properties": {
        "minimal": {
          "type": "string"
        },
        "enhanced": {
          "type": "string"
        },
        "study": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimal",
            "enhanced"
          ],
          "properties": {
            "minimal": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "translation_zh",
                "highlights"
              ],
              "properties": {
                "translation_zh": {
                  "type": "string",
                  "maxLength": 15000
                },
                "highlights": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "reason_zh"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "reason_zh": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    }
                  }
                }
              }
            },
            "enhanced": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "translation_zh",
                "highlights"
              ],
              "properties": {
                "translation_zh": {
                  "type": "string",
                  "maxLength": 15000
                },
                "highlights": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "reason_zh"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "reason_zh": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_issues",
        "expressions",
        "practice_advice"
      ],
      "properties": {
        "top_issues": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "expressions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expression",
              "meaning",
              "usage"
            ],
            "properties": {
              "expression": {
                "type": "string"
              },
              "meaning": {
                "type": "string"
              },
              "usage": {
                "type": "string"
              }
            }
          }
        },
        "practice_advice": {
          "type": "string"
        }
      }
    }
  }
}
