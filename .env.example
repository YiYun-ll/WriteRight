# SERVER ONLY: copy to supabase/.env.local. Do not commit real values.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Project default chosen by the user; verify availability when changing providers.
DEFAULT_GRADING_MODEL=deepseek-flash
DEFAULT_PARSER_MODEL=deepseek-flash
AI_PROVIDER=mock
# Local/internal worker only. Use a random value in real deployments.
WRITERIGHT_WORKER_TOKEN=

# Optional QQ SMTP settings: copy these placeholders to ignored supabase/.env.smtp.
# The authorization code belongs only in Supabase Auth SMTP, never the iOS App.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=WriteRight
