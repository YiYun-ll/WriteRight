{
  "name": "essaypilot-dev",
  "version": "0.1.0",
  "private": true,
  "description": "Development tooling for the EssayPilot native iOS app and Supabase backend",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "env:check": "node scripts/check-environment.mjs",
    "supabase": "supabase",
    "backend:start": "node scripts/start-backend.mjs",
    "backend:stop": "supabase stop",
    "backend:status": "supabase status",
    "functions:serve": "supabase functions serve --network-id essaypilot-local --env-file supabase/.env.local",
    "check": "deno task check",
    "test": "deno task test",
    "test:db": "supabase test db --local --network-id essaypilot-local supabase/tests",
    "ios:generate": "./scripts/generate-ios.sh",
    "ios:build": "./scripts/build-ios.sh",
    "ios:run": "./scripts/run-ios.sh",
    "test:ios": "./scripts/test-ios.sh",
    "test:grading": "node scripts/test-grading-integration.mjs --live",
    "poc:grading": "deno run --env-file=supabase/.env.local --allow-env=DEEPSEEK_API_KEY,DEEPSEEK_BASE_URL,DEFAULT_GRADING_MODEL --allow-net=api.deepseek.com,127.0.0.1:7890 --allow-write=artifacts scripts/poc-grading.ts --live",
    "test:ocr-layout": "./scripts/test-ocr-layout.sh",
    "backend:worker:configure": "node scripts/configure-local-worker.mjs",
    "test:worker-schedule": "node scripts/test-local-worker-schedule.mjs --live"
  },
  "devDependencies": {
    "supabase": "2.122.0"
  }
}
